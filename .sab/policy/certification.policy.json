{
  "policy_version": "1.2",
  "policy_name": "SAB Quality Gate Merge Policy",
  "rules": [
    {
      "id": "RULE_ZERO_REGRESSIONS",
      "field": "verification.new_regressions",
      "operator": "EQUALS",
      "expected_value": 0,
      "gate": "regression",
      "description": "Zero new test regressions allowed outside documented baseline debt."
    },
    {
      "id": "RULE_ZERO_FAILURES",
      "field": "verification.failures",
      "operator": "EQUALS",
      "expected_value": 0,
      "gate": "repository_health",
      "waivable": true,
      "description": "Repository test failures must be zero or explicitly waived via baseline debt register."
    },
    {
      "id": "RULE_ZERO_ERRORS",
      "field": "verification.errors",
      "operator": "EQUALS",
      "expected_value": 0,
      "gate": "repository_health",
      "waivable": true,
      "description": "Repository test errors must be zero or explicitly waived via baseline debt register."
    },
    {
      "id": "RULE_PREFLIGHT_PASS",
      "field": "audit.preflight_status",
      "operator": "EQUALS",
      "expected_value": "PASS",
      "gate": "governance",
      "description": "Preflight golden rules guard check must be PASS."
    },
    {
      "id": "RULE_APPROVAL_STATUS",
      "field": "approval.status",
      "operator": "EQUALS",
      "expected_value": "APPROVED_FOR_MERGE",
      "gate": "governance",
      "description": "Approval status must be APPROVED_FOR_MERGE."
    }
  ],
  "baseline_waiver": {
    "waiver_field": "baseline.exempted_failures",
    "waiver_errors_field": "baseline.exempted_errors",
    "enforce_expiry": true,
    "expiry_field": "waiver.expires_at",
    "enforce_fingerprint": true,
    "fingerprint_field": "baseline.fingerprint_hash",
    "fingerprint_source_field": "baseline.failing_test_identities",
    "enforce_provenance": true,
    "provenance_fields": ["waiver.approved_by", "waiver.reason", "waiver.commit_sha"],
    "description": "Waiver requires: (1) count match, (2) valid expiry date, (3) canonical fingerprint match from failing_test_identities, (4) provenance fields present."
  }
}
